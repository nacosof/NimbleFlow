# App
# Публичный URL сайта (локально или прод)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js: openssl rand -base64 32
AUTH_SECRET=

# Database: postgres | mysql
DB_PROVIDER=postgres
# Postgres: postgresql://user:pass@localhost:5432/nimbleflow
# MySQL: mysql://user:pass@localhost:3306/nimbleflow
DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# Yandex ID — https://oauth.yandex.ru/
AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=

# VK ID — https://id.vk.com/about/business/go/docs
AUTH_VK_ID=
AUTH_VK_SECRET=

# Mail.ru — https://oauth.mail.ru/
AUTH_MAILRU_ID=
AUTH_MAILRU_SECRET=

# SMS OTP (подтверждение телефона в форме регистрации): smsru | console
SMS_PROVIDER=console
SMSRU_API_ID=
# SMSRU_FROM=

# Payments: yookassa | robokassa
PAYMENT_PROVIDER=yookassa

# ЮKassa — https://yookassa.ru/my
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/profile?paid=1

# Robokassa — https://partner.robokassa.ru/
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_IS_TEST=1
ROBOKASSA_RESULT_URL=http://localhost:3000/api/webhooks/robokassa
ROBOKASSA_SUCCESS_URL=http://localhost:3000/profile?paid=1
ROBOKASSA_FAIL_URL=http://localhost:3000/profile?paid=0

# Email: smtp | unisender
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="NimbleFlow <noreply@example.ru>"
# UNISENDER_API_KEY=
# UNISENDER_SENDER_EMAIL=

# AI: openrouter | openai | mistral | genapi | deepseek | anthropic | gemini | grok | openai_compatible
AI_PROVIDER=openrouter
AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=
